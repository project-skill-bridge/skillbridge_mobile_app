<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".circlobrustGame.circlobrustLevelSuccessActivities.Level1CompletionClass">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Background Animations -->


        <ImageView
            android:id="@+id/gifViewlevel1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toTopOf="@+id/backgroundImagelevel5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Main Content Container -->
        <ImageView
            android:id="@+id/backgroundImagelevel5"
            android:layout_width="match_parent"
            android:layout_height="229dp"
            android:layout_marginTop="400dp"
            android:scaleType="fitXY"
            android:src="@drawable/circlo_brust_background_level_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0" />

        <!-- Rest of your UI elements -->
        <TextView
            android:id="@+id/textView2level1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:fontFamily="@font/congratulations_font"
            android:text="You did it !"
            android:textColor="#0F0E0E"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        
        <!-- Level 2 Unlocked Text -->
        <TextView
            android:id="@+id/textView3level1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/level_name_font"
            android:text="All levels completed!"
            android:textColor="#800080"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView2level1" />


        <!-- Level Completed Badge -->

        <!-- Game Level Name (Floating Dots) -->
        <ImageView
            android:id="@+id/LevelCompletedlevel5"
            android:layout_width="250dp"
            android:layout_height="200dp"
            android:layout_marginTop="28dp"
            android:scaleType="fitCenter"
            android:src="@drawable/level_5_completed_badge_5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView3level1" />

        <!-- Level Progress Bar -->

        

        <TextView
            android:id="@+id/textView4level1"
            android:layout_width="285dp"
            android:layout_height="63dp"
            android:layout_marginTop="36dp"
            android:fontFamily="@font/final_font_bold"
            android:text="You’re a Circle Popping Champion! "
            android:textAlignment="center"
            android:textColor="#101010"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.523"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/LevelCompletedlevel5" />

        <ImageView
            android:id="@+id/winner_logolevel5"
            android:layout_width="321dp"
            android:layout_height="30dp"
            android:layout_marginTop="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/circlobrust_level_5_score_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.333"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView4level1" />

        <TextView
            android:id="@+id/textViewpointslevel1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/points_font"
            android:text="Points : 10/10"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/winner_logolevel5" />

        <Button
            android:id="@+id/BackToHome"
            android:layout_width="254dp"
            android:layout_height="59dp"
            android:layout_marginBottom="52dp"
            android:background="@drawable/level1_continue_rounded_button"
            android:padding="10dp"
            android:text="Back To Home"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Exit Button -->


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>